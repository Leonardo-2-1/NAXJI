+INSERT INTO public.campos_plantilla(plantilla_id,clave,etiqueta,tipo_dato,obligatorio,orden,configuracion)
+SELECT p.id,v.clave,v.etiqueta,v.tipo,v.obligatorio,v.orden,'{}'::jsonb
+FROM (VALUES
