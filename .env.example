# En local deje vacio: Vite usa el proxy /api -> http://127.0.0.1:8000
# Si publica el front por separado, apunte a la URL del backend de Nathalie:
# VITE_API_URL=http://127.0.0.1:8000

# Configure lo siguiente en .env.local, sin sobrescribir su .env PostgreSQL.
# Nunca utilice prefijo VITE_ para variables NAXJI_DB_* ni secretos de sesiones.
NAXJI_PERSISTENCE_MODE=postgres
NAXJI_AUTH_MODE=supabase
NAXJI_SUPABASE_URL=https://SU_PROYECTO.supabase.co
NAXJI_SUPABASE_PUBLISHABLE_KEY=SU_CLAVE_PUBLICABLE_O_ANON
# Obligatorio para la cookie SameSite=None, también en pruebas de autenticación.
NAXJI_AUTH_COOKIE_SECURE=true
NAXJI_AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Despliegue temporal Pages + Railway: ver docs/AUTH_PAGES_RAILWAY.md.
# NAXJI_AUTH_ALLOWED_ORIGINS=https://naxji.pages.dev
# NAXJI_CORS_ORIGINS=https://naxji.pages.dev
# VITE_API_URL=https://naxji-production.up.railway.app

# Solo backend; nunca usar prefijo VITE_ para la conexión de Ollama.
NAXJI_OLLAMA_BASE_URL=http://localhost:11434
NAXJI_OLLAMA_MODEL=qwen2.5:7b
# Límite total de la petición, incluido cargar el modelo (1..1800 segundos).
NAXJI_OLLAMA_TIMEOUT_SECONDS=300
